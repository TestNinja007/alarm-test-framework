# Where the application under test is served. The API and the UI share one
# origin, so this is the only address the suite needs.
BASE_URL=http://127.0.0.1:8080

# Direct database access, used by the pytest layer in database/ - the stack
# that asks whether a cascade really removed rows and whether a column really
# holds a zone. Read by both stacks from this one file, so they cannot end up
# pointed at different systems.
#
# Leave it unset and the database layer skips; the Playwright suite runs
# regardless. In CI it is always set, and the workflow refuses to let the
# layer skip - there, a missing database is a broken workflow.
#
# Use the same value as the application: copy DATABASE_URL out of its .env
# rather than guessing, since the credentials are whatever Postgres was
# installed with.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/alarm_configurator
