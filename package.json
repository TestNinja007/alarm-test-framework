{
  "name": "alarm-test-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated tests for Nudge (alarm-configurator), kept apart from the application they exercise.",
  "scripts": {
    "test": "playwright test --project=api --project=chromium",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:browsers": "playwright test --project=chromium && playwright test --project=firefox && playwright test --project=webkit",
    "test:serial": "playwright test --project=api --project=chromium --grep @serial --workers=1",
    "test:parallel": "playwright test --project=api --project=chromium --grep-invert @serial",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "pg": "^8.16.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1"
  }
}
